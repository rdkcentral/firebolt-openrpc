            ],
            "result": {
                "name": "value",
                "schema": {
                    "type": "boolean"
                }
            },
            "examples": [
                {
                    "name": "Get the property for hulu",
                    "params": [
                        {
                            "name": "appId",
                            "value": "hulu"
                        }
                    ],
                    "result": {
                        "name": "value",
                        "value": false
                    }
                },
                {
                    "name": "Get the property for peacock",
                    "params": [
                        {
                            "name": "appId",
                            "value": "peacock"
                        }
                    ],
                    "result": {
                        "name": "value",
                        "value": true
                    }
                }
            ]
